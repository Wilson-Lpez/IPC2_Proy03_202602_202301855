@page
@model AyudaModel
@{
    ViewData["Title"] = "Ayuda y Documentación";
}

<div class="text-center mb-4">
    <h2>Información del Sistema</h2>
    <p class="text-muted">Datos del desarrollador y documentación del proyecto</p>
</div>
<hr />

<div class="row mt-4">
    <!-- Lado Izquierdo: Datos del Desarrollador -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white text-center">
                <h5 class="mb-0">Datos del Desarrollador</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Nombre:</strong> [TU NOMBRE AQUÍ]</li>
                    <li class="list-group-item"><strong>Carné:</strong> [TU CARNET AQUÍ]</li>
                    <li class="list-group-item"><strong>Curso:</strong> Introducción a la Programación y Computación 2 (IPC2)</li>
                    <li class="list-group-item"><strong>Proyecto:</strong> Proyecto 3 - Simulador SAT</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Lado Derecho: Solo el Botón de Documentación -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <!-- flexbox centra el botón vertical y horizontalmente en el espacio disponible -->
            <div class="card-body d-flex align-items-center justify-content-center">
                <a href="https://github.com/Wilson-Lpez/IPC2_Proy03_202602_202301855.git" target="_blank" class="btn btn-success btn-lg px-5 py-3 shadow">
                    Documentación
                </a>
            </div>
        </div>
    </div>
</div>